<?xml version="1.0" encoding="utf-8" ?>
<!-- OTP: one box per digit (Limits.OtpLength = 6) with a transparent Entry laid over them. -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:Expovice.App.Pages"
                xmlns:c="clr-namespace:Expovice.App.Controls"
                xmlns:vm="clr-namespace:Expovice.App.Core.ViewModels;assembly=Expovice.App.Core"
                x:Class="Expovice.App.Pages.OtpPage"
                x:DataType="vm:OtpViewModel">
  <Grid RowDefinitions="*,Auto" Padding="28,8,28,24">
    <VerticalStackLayout Spacing="22">
      <c:IconButton Icon="chevL" Command="{Binding BackCommand}" HorizontalOptions="Start" SemanticProperties.Description="Back" />
      <VerticalStackLayout Spacing="8">
        <Label Text="Enter the code" Style="{StaticResource Heading}" />
        <Label Text="{Binding Subtitle}" Style="{StaticResource Sub}" />
      </VerticalStackLayout>

      <Grid HorizontalOptions="Start">
        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Boxes}">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:OtpBox">
              <Border WidthRequest="48" HeightRequest="60" StrokeShape="RoundRectangle 20" StrokeThickness="2"
                      Background="{StaticResource SurfaceBrush}" Stroke="{StaticResource DividerBrush}">
                <Border.Triggers>
                  <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                  </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Digit}" FontFamily="Caprasimo" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
        <Entry x:Name="CodeEntry" Text="{Binding Code}" Keyboard="Numeric" MaxLength="{Binding CodeLength}"
               Opacity="0.01" TextColor="Transparent" ReturnCommand="{Binding VerifyCommand}"
               SemanticProperties.Description="Verification code" />
      </Grid>

      <HorizontalStackLayout Spacing="4">
        <Label Text="Didn't get it?" FontSize="14" TextColor="{StaticResource Neutral700}" VerticalOptions="Center" />
        <Button Text="{Binding ResendText}" Style="{StaticResource GhostButton}" FontFamily="FigtreeSemiBold" Command="{Binding ResendCommand}" />
      </HorizontalStackLayout>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" />
    </VerticalStackLayout>

    <Button Grid.Row="1" Text="Verify" Style="{StaticResource PrimaryButton}" Command="{Binding VerifyCommand}" />
  </Grid>
</pages:BasePage>
